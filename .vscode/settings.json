{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.eol": "\n",
  "files.exclude": {
    "**/.env": true,
    "**/.editorconfig": true,
    "**/.gitattributes": true,
    "**/.dockerignore": true,
    "**/docker-entrypoint.sh": true,
    "**/package-lock.json": true
  }
}
